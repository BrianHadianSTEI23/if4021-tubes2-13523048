    <slider x="10" step="0.25" y="160" max="8.0" width="232" display="separation-radius" height="46" min="0.5" direction="Horizontal" default="2.5" variable="separation-radius" units="patches"></slider>
    <slider x="10" step="10.0" y="210" max="360.0" width="232" display="fov-angle" height="46" min="60.0" direction="Horizontal" default="270.0" variable="fov-angle" units="deg"></slider>
    <slider x="10" step="0.1" y="260" max="5.0" width="232" display="separation-weight" height="46" min="0.0" direction="Horizontal" default="1.8" variable="separation-weight"></slider>
    <slider x="10" step="0.1" y="310" max="5.0" width="232" display="alignment-weight" height="46" min="0.0" direction="Horizontal" default="1.2" variable="alignment-weight"></slider>
    <slider x="10" step="0.1" y="360" max="5.0" width="232" display="cohesion-weight" height="46" min="0.0" direction="Horizontal" default="1.0" variable="cohesion-weight"></slider>
    <slider x="10" step="0.1" y="410" max="2.5" width="232" display="max-speed" height="46" min="0.2" direction="Horizontal" default="1.0" variable="max-speed"></slider>
